\3e\cc\25\e9\3c\d2\78\85\bd\5a\1f\d8\3c\40\a4\90\bd\1a\2a\a4\bf\6c\22\1c\bf\c8\d4\0b\3f\d5\52\ee\3c\41\dd\be\be\40\9b\1d\c0\16\0d\e8\be\06\46\37\bc\27\8f\5f\3e\8f\06\b1\3f\18\0f\08\be\6d\24\76\be\4d\0c\eb\3d\c4\d2\0b\3f\7e\c2\e3\3e\60\e1\63\3e\f5\bd\22\bf\ce\23\f2\3c\81\69\50\bd\27\df\c8\be\20\4c\ad\be\c7\23\07\3f\a5\dc\24\3f\62\66\4b\3d\4f\06\86\3d\4c\6c\df\3e\ae\2b\2c\3e\f9\7f\06\bf\4a\52\ea\be\ef\fa\a7\be\cf\8a\2d\3e\17\80\ee\3c\70\49\a3\bf\d0\62\9f\bf\b4\b6\54\3e\82\73\bf\3e\4f\fb\6e\bf\af\b8\33\be")
  (data (i32.const 23356) "\31\30\27\3d\ee\3f\f2\3e\56\11\6b\bd\d7\88\f8\bc\fa\0f\34\be\2b\e2\3b\bd\7c\ff\fe\bd\91\69\31\3d\38\91\c2\3d\72\f1\6f\be\ff\f3\84\3e\98\e4\34\3e\01\b3\31\3d\3f\20\87\be\f8\db\5d\be\b3\3a\37\3e\c6\6d\8e\3e\01\ec\82\bd\0d\a9\e8\bd\dd\71\cf\3d\c2\d3\89\bd\32\a3\0a\be\7e\65\43\be\90\98\3c\3b\11\be\1e\bd\94\b4\77\bd\39\f3\88\3d\7b\29\29\be\ed\41\73\be\a6\0f\c0\bd\12\3f\04\be\e7\55\75\3d\e8\62\bd\bc\1c\47\c4\bc\60\11\0a\be\05\0a\f2\3d\cd\ea\06\be\95\ba\a7\bd\23\63\9f\bc\1b\48\9a\3c\eb\b3\bd\bd\9a\44\1c\be\66\57\70\3d\a8\63\a6\bd\ea\e9\09\be\ae\57\d9\3d\2c\97\fe\3c\bd\8a\30\be\35\31\4d\bd\bc\b9\e7\3d\8f\93\08\be\04\eb\97\bd\7d\02\67\3d\2f\c1\8b\3d\cf\a0\a2\3d\d2\ad\1b\be\bd\44\13\3d\9b\d3\c5\be\26\29\e9\3d\33\e1\05\3e\4b\a4\65\be\ca\22\d5\3d\cd\0c\9a\bc\36\0f\7b\3d\a8\19\f7\bc\ad\b6\a2\3c\e0\2b\3f\bd\47\1d\b8\3d\19\0e\7a\bd\f7\37\12\be\2c\ff\fc\bc\44\3b\28\3e\c9\09\0c\be\bf\56\da\bd\8e\27\0d\bd\09\91\a4\bd\fa\e7\a4\bd\68\78\89\3d\cc\11\7d\3e\2b\7c\d0\3c\0d\42\c8\bd\03\94\0c\3d\5e\34\d8\3d\5a\27\df\be\c1\e8\aa\be\2c\b3\96\3d\8c\82\93\bd\26\79\54\3d\23\02\e1\3d\ff\2f\5f\3e\0e\01\b2\3d\85\65\22\bd\2d\6f\60\3e\e1\76\8e\bd\37\57\48\be")
  ;; $fc: generic dense layer
  ;; in_ptr, out_ptr, w_ptr, b_ptr: byte offsets into linear memory
  ;; in_dim, out_dim: number of neurons
  (func $fc
        (param $in_ptr i32) (param $out_ptr i32)
        (param $w_ptr  i32) (param $b_ptr  i32)
        (param $in_dim i32) (param $out_dim i32)
    (local $j i32)
    (local $i i32)
    (local $acc f32)
    (local $w_row i32)
    (local.set $j (i32.const 0))
    (block $break_outer
      (loop $outer
        (br_if $break_outer (i32.ge_u (local.get $j) (local.get $out_dim)))
        ;; acc = bias[j]
        (local.set $acc
          (f32.load
            (i32.add (local.get $b_ptr)
                     (i32.mul (local.get $j) (i32.const 4)))))
        ;; w_row = w_ptr + j * in_dim * 4
        (local.set $w_row
          (i32.add (local.get $w_ptr)
                   (i32.mul (local.get $j)
                            (i32.mul (local.get $in_dim) (i32.const 4)))))
        (local.set $i (i32.const 0))
        (block $break_inner
          (loop $inner
            (br_if $break_inner (i32.ge_u (local.get $i) (local.get $in_dim)))
            ;; acc += in[i] * w[j * in_dim + i]
            (local.set $acc
              (f32.add (local.get $acc)
                (f32.mul
                  (f32.load
                    (i32.add (local.get $in_ptr)
                             (i32.mul (local.get $i) (i32.const 4))))
                  (f32.load
                    (i32.add (local.get $w_row)
                             (i32.mul (local.get $i) (i32.const 4)))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $inner)))
        ;; out[j] = acc
        (f32.store
          (i32.add (local.get $out_ptr)
                   (i32.mul (local.get $j) (i32.const 4)))
          (local.get $acc))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $outer)))
  )
  ;; $relu_buf: apply ReLU in-place to a buffer of f32
  (func $relu_buf (param $ptr i32) (param $len i32)
    (local $i i32)
    (local.set $i (i32.const 0))
    (block $break
      (loop $loop
        (br_if $break (i32.ge_u (local.get $i) (local.get $len)))
        (f32.store
          (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 4)))
          (f32.max
            (f32.load
              (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 4))))
            (f32.const 0.0)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )
  ;; $argmax: return index of maximum f32 in buffer; len must be >= 1
  (func $argmax (param $ptr i32) (param $len i32) (result i32)
    (local $i i32)
    (local $best_idx i32)
    (local $best_val f32)
    (local $val f32)
    (local.set $best_idx (i32.const 0))
    (local.set $best_val (f32.load (local.get $ptr)))
    (local.set $i (i32.const 1))
    (block $break
      (loop $loop
        (br_if $break (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $val
          (f32.load
            (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 4)))))
        (if (f32.gt (local.get $val) (local.get $best_val))
          (then
            (local.set $best_val (local.get $val))
            (local.set $best_idx (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
    (local.get $best_idx)
  )
  ;; infer: run the full 2-layer network; caller writes f32 input at $in_ptr
  ;; returns argmax class index (i32)
  (func (export "infer") (param $in_ptr i32) (result i32)
    ;; layer 1
    (call $fc
      (local.get $in_ptr) (i32.const 320)
      (i32.const 828) (i32.const 11068)
      (i32.const 80) (i32.const 32))
    ;; relu on hidden buffer
    (call $relu_buf (i32.const 320) (i32.const 32))
    ;; layer 2
    (call $fc
      (i32.const 320) (i32.const 448)
      (i32.const 11196) (i32.const 23356)
      (i32.const 32) (i32.const 95))
    ;; argmax
    (call $argmax (i32.const 448) (i32.const 95))
  )
)
