{
  "name": "wasm-viewer",
  "displayName": "WASM Binary Viewer",
  "description": "Readonly hex inspector for .wasm binary files — section breakdown, exports, imports",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "wasmViewer.wasm",
        "displayName": "WASM Binary",
        "selector": [
          {
            "filenamePattern": "*.wasm"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "install-ext": "npm run package && code --install-extension wasm-viewer-*.vsix"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}
